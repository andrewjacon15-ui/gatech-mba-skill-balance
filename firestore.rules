rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules, then Publish.
// Replace YOUR_CLASS_CODE with the exact same value you put in firebase-config.js (window.CLASS_CODE).
//
// What this allows, by design (no backend = no real auth):
//   - Anyone with the link can read the roster (needed so the static admin dashboard
//     can list students without a server).
//   - Anyone can create/update a student doc, but ONLY if they include the correct
//     classCode in the write. This is a deterrent, not real security -- the code is
//     visible in the page's JS source to anyone who looks.
//   - Each document is keyed by the student's lowercased email, so submitting the
//     same email again overwrites (updates) their own entry instead of duplicating it.
//   - Hard deletes are blocked entirely. "Remove" in the app soft-deletes by setting
//     removed: true (an update, not a delete), because Firestore delete requests carry
//     no data to check a classCode against, so there'd be no way to gate a real delete.
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentEmail} {
      allow read: if true;
      allow create, update: if request.resource.data.classCode == "YOUR_CLASS_CODE"
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.email is string
                   && request.resource.data.email.lower() == studentEmail;
      allow delete: if false;
    }
  }
}
